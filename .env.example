# Copy this file to .env and fill in your SQL Server credentials.
# File .env is ignored by Git and will not be pushed.

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=DWatchDB
DB_USER=sa
DB_PASSWORD=your_password_here

# Optional: creates this admin account on startup (bcrypt-hashed) if it
# doesn't exist yet. Leave blank to keep using the default admin/admin123
# seed from database.sql (it still works — passwords upgrade automatically).
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional: Gmail SMTP for order-confirmation / password-reset emails.
# Without these, email sending fails silently (logged, not fatal).
MAIL_FROM=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=DWatch Shop
